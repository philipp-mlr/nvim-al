#!/usr/bin/env bash
# Run tests headless with mini.test. Exit 1 on any failure, including files that fail to load.
#   scripts/test                         all tests/unit/test_*.lua
#   scripts/test tests/unit/test_x.lua   selected files
#   NVIM_AL_INTEGRATION=1 scripts/test tests/integration/test_lsp.lua
set -euo pipefail
cd "$(dirname "$0")/.."

if [ $# -gt 0 ]; then
  files=$(printf '"%s",' "$@")
else
  files=$(find tests/unit -name 'test_*.lua' | sort | sed 's/.*/"&",/' | tr -d '\n')
fi

exec timeout "${NVIM_AL_TEST_TIMEOUT:-600}" nvim --headless --noplugin -u tests/minimal_init.lua \
  -c "lua require('runner').run({ ${files} })"
